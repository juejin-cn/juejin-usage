{
  "name": "@juejin-opensource/jusage-core",
  "version": "1.1.0",
  "description": "AI Agent Token 用量采集与本地 API 核心库（parsers / sync / hooks / pricing / upload）",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juejin-cn/juejin-usage.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/juejin-cn/juejin-usage/issues"
  },
  "homepage": "https://github.com/juejin-cn/juejin-usage#readme",
  "keywords": [
    "ai",
    "token",
    "usage",
    "parser",
    "sync"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./leaderboard": {
      "types": "./dist/leaderboard.d.ts",
      "import": "./dist/leaderboard.js"
    },
    "./daily-model-key": {
      "types": "./dist/daily-model-key.d.ts",
      "import": "./dist/daily-model-key.js"
    },
    "./dashboard-trend": {
      "types": "./dist/dashboard-trend.d.ts",
      "import": "./dist/dashboard-trend.js"
    },
    "./timezone": {
      "types": "./dist/timezone.d.ts",
      "import": "./dist/timezone.js"
    },
    "./project-label": {
      "types": "./dist/project-label.d.ts",
      "import": "./dist/project-label.js"
    },
    "./local-metrics": {
      "types": "./dist/local-metrics.d.ts",
      "import": "./dist/local-metrics.js"
    },
    "./reconcile-skip": {
      "types": "./dist/reconcile-skip.d.ts",
      "import": "./dist/reconcile-skip.js"
    },
    "./usage-cards": {
      "types": "./dist/usage-cards.d.ts",
      "import": "./dist/usage-cards.js"
    },
    "./subscription": {
      "types": "./dist/subscription/index.d.ts",
      "import": "./dist/subscription/index.js",
      "default": "./dist/subscription/index.js"
    },
    "./subscription/read": {
      "types": "./dist/subscription/read.d.ts",
      "import": "./dist/subscription/read.js",
      "default": "./dist/subscription/read.js"
    },
    "./subscription/transport": {
      "types": "./dist/subscription/transport.d.ts",
      "import": "./dist/subscription/transport.js",
      "default": "./dist/subscription/transport.js"
    },
    "./subscription/shared/*": {
      "types": "./dist/subscription/shared/*.d.ts",
      "import": "./dist/subscription/shared/*.js",
      "default": "./dist/subscription/shared/*.js"
    },
    "./subscription/readers/*": {
      "types": "./dist/subscription/readers/*.d.ts",
      "import": "./dist/subscription/readers/*.js",
      "default": "./dist/subscription/readers/*.js"
    },
    "./agent-router": {
      "types": "./dist/agent-router/index.d.ts",
      "import": "./dist/agent-router/index.js"
    },
    "./agent-router/model-metadata": {
      "types": "./dist/agent-router/model-metadata.d.ts",
      "import": "./dist/agent-router/model-metadata.js"
    },
    "./agent-router/presets": {
      "types": "./dist/agent-router/presets.d.ts",
      "import": "./dist/agent-router/presets.js"
    },
    "./agent-router/limits": {
      "types": "./dist/agent-router/limits.d.ts",
      "import": "./dist/agent-router/limits.js"
    },
    "./pet-sync-feedback": {
      "types": "./dist/pet-sync-feedback.d.ts",
      "import": "./dist/pet-sync-feedback.js",
      "default": "./dist/pet-sync-feedback.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-usage-cards.mjs && tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/pricing/pricing.json','dist/pricing/pricing.json')\"",
    "dev": "tsc -p tsconfig.json --watch",
    "sync:pricing": "node scripts/sync-pricing.mjs",
    "test": "pnpm test:compile && node --test dist-test/test/*.test.js",
    "test:compile": "tsc -p tsconfig.test.json && node -e \"require('node:fs').copyFileSync('src/pricing/pricing.json','dist-test/src/pricing/pricing.json')\""
  },
  "dependencies": {
    "fzstd": "^0.1.1",
    "hono": "^4.7.5",
    "jsonc-parser": "^3.3.1",
    "proper-lockfile": "^4.1.2",
    "toml-eslint-parser": "^1.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
