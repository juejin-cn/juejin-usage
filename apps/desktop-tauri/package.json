{
  "name": "@juejin-opensource/jusage-desktop-tauri",
  "version": "1.1.15",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "prepare:app": "node scripts/prepare-app.mjs",
    "stage": "node scripts/stage-node-app.mjs",
    "dev": "node scripts/dev.mjs",
    "bundle": "node scripts/build-native.mjs",
    "tauri": "tauri",
    "test:staged": "node scripts/test-staged.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "artifacts": "node scripts/collect-artifacts.mjs",
    "bundle:release": "node scripts/release-config.mjs && node scripts/build-native.mjs --config src-tauri/tauri.release.generated.json",
    "test:packaged": "node scripts/test-packaged.mjs",
    "golden": "node scripts/capture-golden.mjs",
    "golden:rust": "node scripts/verify-native-daily.mjs",
    "node:build:small-icu": "node scripts/build-small-icu.mjs",
    "dev:once": "tauri dev --no-dev-server --features custom-protocol"
  },
  "dependencies": {
    "@juejin-opensource/jusage-core": "workspace:*"
  },
  "devDependencies": {
    "@juejin-opensource/jusage-dashboard": "workspace:*",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
