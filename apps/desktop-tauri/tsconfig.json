{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "../../packages/desktop-ui/src/*"
      ],
      "@juejin-opensource/jusage-desktop-ui": [
        "../../packages/desktop-ui/src"
      ],
      "@juejin-opensource/jusage-desktop-ui/*": [
        "../../packages/desktop-ui/src/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules/@types"
    ],
    "skipLibCheck": true,
    "noImplicitAny": false
  },
  "include": [
    "src",
    "../../packages/desktop-ui/src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
