{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Juejin Usage",
  "version": "1.0.0",
  "identifier": "com.juejin.tud.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm prepare:app",
      "wait": true
    },
    "beforeBuildCommand": "pnpm prepare:app",
    "frontendDist": "../dist/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": [
      "node-app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/jusage-node"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "dmg": {
        "background": "resources/dmg/background.png",
        "window_size": { "width": 660, "height": 400 },
        "app_position": { "x": 180, "y": 170 },
        "application_folder_position": { "x": 480, "y": 170 }
      }
    }
  }
}
