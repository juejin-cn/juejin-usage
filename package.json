{
  "name": "ai-usage",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juejin-cn/juejin-usage.git"
  },
  "bugs": {
    "url": "https://github.com/juejin-cn/juejin-usage/issues"
  },
  "homepage": "https://github.com/juejin-cn/juejin-usage#readme",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/**\" -r build",
    "build:cli": "pnpm --filter @juejin-opensource/jusage... build",
    "start": "pnpm start:cli",
    "start:cli": "pnpm build:cli && pnpm --filter @juejin-opensource/jusage start",
    "dev:cli": "pnpm build:cli && node scripts/run-parallel.mjs dev:cli:api dev:cli:ui",
    "dev:cli:api": "pnpm --filter @juejin-opensource/jusage start",
    "dev:cli:ui": "cross-env VITE_API_TARGET=cli pnpm --filter @juejin-opensource/jusage-dashboard dev -- --open",
    "dev:web": "cross-env VITE_API_TARGET=server VITE_API_BASE=https://api.juejin.cn/aiusage_api VITE_BASE=/aiusage/ VITE_ROUTER_BASE=/aiusage/ pnpm --filter @juejin-opensource/jusage-dashboard dev",
    "dev:web:proxy": "cross-env DEV_API_PROXY=https://api.juejin.cn/aiusage_api VITE_API_TARGET=server VITE_BASE=/aiusage/ VITE_ROUTER_BASE=/aiusage/ pnpm --filter @juejin-opensource/jusage-dashboard dev",
    "sync": "pnpm --filter @juejin-opensource/jusage sync",
    "sync:pricing": "pnpm --filter @juejin-opensource/jusage-core sync:pricing",
    "dev:dashboard": "pnpm --filter @juejin-opensource/jusage-dashboard dev",
    "start:dashboard": "pnpm --filter @juejin-opensource/jusage-dashboard preview",
    "dev:desktop": "pnpm --filter \"@juejin-opensource/jusage-desktop^...\" build && pnpm --filter @juejin-opensource/jusage-desktop dev",
    "build:desktop": "pnpm --filter @juejin-opensource/jusage-desktop... build",
    "build:desktop:mac": "pnpm --filter \"@juejin-opensource/jusage-desktop^...\" build && pnpm --filter @juejin-opensource/jusage-desktop build:mac",
    "build:desktop:mac:arm": "pnpm --filter \"@juejin-opensource/jusage-desktop^...\" build && pnpm --filter @juejin-opensource/jusage-desktop build:mac:arm",
    "build:desktop:win": "pnpm --filter \"@juejin-opensource/jusage-desktop^...\" build && pnpm --filter @juejin-opensource/jusage-desktop build:win",
    "release:desktop:mac": "pnpm --filter \"@juejin-opensource/jusage-desktop^...\" build && pnpm --filter @juejin-opensource/jusage-desktop release:mac",
    "release:desktop:win": "pnpm --filter \"@juejin-opensource/jusage-desktop^...\" build && pnpm --filter @juejin-opensource/jusage-desktop release:win",
    "start:desktop": "pnpm --filter \"@juejin-opensource/jusage-desktop^...\" build && pnpm --filter @juejin-opensource/jusage-desktop start",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:cli && changeset publish"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.20.1",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3"
  }
}
